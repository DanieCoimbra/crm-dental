# Raiz do projeto: nenhuma configuração acima daqui vale
config.stopBubbling = true
# Marca o código gerado (relatórios de cobertura o ignoram)
lombok.addLombokGeneratedAnnotation = true
# Regras do projeto: sem @Data/@ToString/@EqualsAndHashCode em entidades (convenção em docs/global/backend/spec.md, seção 1.1)
lombok.data.flagUsage = error
lombok.toString.flagUsage = error
lombok.equalsAndHashCode.flagUsage = error
