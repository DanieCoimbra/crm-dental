# Copie para .env (nunca versionado) e preencha. Nenhum valor real neste arquivo.
# Perfil: dev | test | prod
SPRING_PROFILES_ACTIVE=dev
# Porta HTTP (padrão 8080; o Render define PORT)
PORT=8080

# --- Banco (papel de aplicação crm_app; nunca o papel dono/migrations) ---
# prod: TLS obrigatório (sslmode=require ou mais estrito) e, no Supabase, pooler em modo transaction
#       (porta 6543, usuário crm_app.<project-ref>) com prepareThreshold=0.
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_APP_USER=crm_app
DB_APP_PASSWORD=

# --- Somente docker-compose local (aplica database/bootstrap e database/migrations) ---
# Cada senha com pelo menos 24 caracteres; gere com: openssl rand -base64 36 | tr -d '/+=\n'
POSTGRES_PASSWORD=
DB_OWNER_PASSWORD=
DB_BACKUP_PASSWORD=

# --- Segredos de aplicação (validados nas features F03/F04) ---
# JWT HS256: mínimo 32 bytes, obrigatório em TODOS os perfis. Gere com: openssl rand -base64 48
CRM_JWT_SECRET=
# Chaveiro AES-256: "1:<base64 de 32 bytes>,2:<...>" e a versão ativa (obrigatórios em TODOS os perfis).
# Gere cada chave com: openssl rand -base64 32
# Faça backup das chaves fora do repositório e do banco: perder a chave é perder os dados cifrados.
# Rotação: acrescente a nova versão, torne-a ativa e mantenha as antigas até nenhum dado usá-las.
CRM_AES_KEYS=
CRM_AES_ACTIVE_VERSION=1

# --- Web ---
# Origens do React, separadas por vírgula; em prod somente https://, nunca *
CRM_CORS_ORIGINS=http://localhost:5173

# --- Arquivos de exame: Supabase Storage (Fase 1) ---
# Service key só no backend; nunca no front nem no repositório. Bucket privado.
CRM_STORAGE_URL=
CRM_STORAGE_SERVICE_KEY=
CRM_STORAGE_BUCKET=

# Limites por usuario/minuto dos documentos clinicos (Fase 4); opcionais, padrao 30, faixa 1 a 600
# CRM_CLINICAL_DOCUMENTS_ISSUES_PER_MINUTE=30
# CRM_CLINICAL_DOCUMENTS_PDFS_PER_MINUTE=30
