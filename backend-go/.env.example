# Chave secreta para assinatura dos tokens JWT
JWT_SECRET=dental_crm_super_secret_portfolio_key_2026_change_in_prod

# ------------------------------------------------------------------------------
# BANCO DE DADOS SUPABASE (Escolha o formato adequado ao seu ambiente):
