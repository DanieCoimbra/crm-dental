# ==========================================
# Dental CRM API - Exemplos de Variáveis de Ambiente
# ==========================================

# Porta de execução do servidor
PORT=8080

# Chave secreta para assinatura dos tokens JWT
JWT_SECRET=substitua_por_uma_chave_secreta_forte_de_pelo_menos_32_caracteres

# Conexão com Banco de Dados Supabase (Usar porta 5432 Supavisor Connection Pooler para compatibilidade IPv4 / Render)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[SUA_SENHA]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Configuração de CORS (Origens permitidas separadas por vírgula)
ALLOWED_ORIGINS="https://crm-clinica-ten.vercel.app,http://localhost:3000"

# Credenciais Supabase Storage (Opcional para upload de arquivos)
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_KEY="sua_anon_ou_service_role_key"
